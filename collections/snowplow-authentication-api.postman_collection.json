{
  "item": [
    {
      "id": "52ce6ac0-af6d-438e-8a0a-8facfa17a175",
      "name": "Authentication",
      "description": {
        "content": "Credentials API for obtaining JWT access tokens from API key credentials.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4f67e5a8-15e7-4948-bec1-71b6f6a3d735",
          "name": "Get Access Token",
          "request": {
            "name": "Get Access Token",
            "description": {
              "content": "Exchange API key credentials for a JWT access token. The returned token is used to authenticate all other Console API requests. Requires both X-API-Key-ID and X-API-Key headers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "organizations",
                ":organizationId",
                "credentials",
                "v3",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "organizationId",
                  "description": "(Required) The Snowplow organization UUID"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<object>",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "34a4a368-d922-425f-8cd6-46a8a44635a1",
              "name": "JWT access token returned successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "organizations",
                    ":organizationId",
                    "credentials",
                    "v3",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<uuid>",
                      "key": "organizationId",
                      "description": "(Required) The Snowplow organization UUID"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "<object>",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"accessToken\": \"string\",\n  \"expiresAt\": \"1953-01-27T07:35:49.721Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
